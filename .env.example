# Copy to .env.local and fill in real values. Never commit .env.local.

# ---- App ----
APP_URL=http://localhost:3000
LOG_LEVEL=info
# Secret used to sign session JWT cookies (min 32 chars). Generate: openssl rand -base64 32
SESSION_SECRET=

# ---- Database: Supabase Postgres ----
# Use the Supabase "Transaction pooler" connection string (port 6543), scheme postgresql://
# The driver disables prepared statements, which the transaction pooler requires.
DATABASE_URL=

# ---- Supabase (Storage + Realtime) ----
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key: safe in the browser (used only for Realtime presence)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: SERVER ONLY. Used to issue signed upload URLs and read uploaded files.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=document-uploads
